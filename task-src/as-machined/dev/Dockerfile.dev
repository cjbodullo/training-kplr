FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv libgl1 libglu1-mesa libxrender1 libxext6 libglib2.0-0 libfontconfig1 libxcursor1 libxft2 libxinerama1 \
    && rm -rf /var/lib/apt/lists/*
COPY wheels /wheels
RUN python3 -m venv /opt/cad && /opt/cad/bin/pip install --no-index --find-links /wheels cadquery==2.8.0 pytest==9.1.1 pytest-json-ctrf==0.5.2
ENV PATH=/opt/cad/bin:$PATH
WORKDIR /w
